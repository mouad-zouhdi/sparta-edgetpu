# Environments created by setup/setup_envs.sh
envs/
*.egg-info/
__pycache__/
*.py[cod]

# Model artefacts: published on the Hugging Face Hub, never committed here.
# See docs/MODELS.md.
*.pt
*.pth
*.onnx
*.tflite
models/
outputs/
outputs_pipeline/

# Datasets. The rule is anchored: report/ and paper/ have their own data/
# directories holding the numbers their figures plot, and those are committed.
/data/
calib_data/
cifar-100-python/
*.npy

# Results, which belong with the models rather than with the code
*.csv
benchmark_results.json
cold_start_results.json

# Local scratch
.cache/
*.log
tmp/

# The report and the paper carry their own figure data, which the rules above
# would otherwise exclude. These are a few hundred KB of plotted numbers, not
# measurement artefacts.
!report/figs/data/**
!report/plots/**
!paper/slides_dsd2026/bench/**
!paper/figures/data/**

# LaTeX build products of report/ and paper/. rapport.pdf is committed on
# purpose; everything else here is regenerated by build.sh.
report/*.aux
report/*.bbl
report/*.bcf
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.lof
report/*.lot
report/*.out
report/*.run.xml
report/*.synctex.gz
report/*.toc
report/rapport.log
paper/**/*.aux
paper/**/*.log
paper/**/*.nav
paper/**/*.snm
paper/**/*.toc
paper/**/*.out
paper/**/*.vrb
paper/**/*.synctex.gz
